# Server port
PORT=5000

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Option A (easiest): leave MONGODB_URI empty. The server auto-starts an
# in-memory MongoDB using mongodb-memory-server. Zero install required,
# but data disappears when the server stops.
#
# Option B: install MongoDB Community and point at it for persistent data.
MONGODB_URI=
# MONGODB_URI=mongodb://127.0.0.1:27017/offlinepay

# Force in-memory mode even when MONGODB_URI is set (useful for tests).
USE_MEMORY_DB=false

# --- Offline spend controls (Phase 7 will enforce these) --------------------
# Maximum amount a wallet may spend while offline, before server reconciliation.
MAX_OFFLINE_TRANSACTION_LIMIT=500
